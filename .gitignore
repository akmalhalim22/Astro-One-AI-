# ── Build output ─────────────────────────────────────────────────────────────
dist/
.wrangler/

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.yarn/
!.yarn/releases

# ── Environment & Secrets ─────────────────────────────────────────────────────
# NEVER commit real credentials — use wrangler secret put for production
.env
.env.*
.env.production
.env.local
.dev.vars            # local wrangler dev secrets (contains real API keys)
*.pem
*.key
service-account*.json
*-service-account.json

# ── Editor / OS ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Runtime / Process ────────────────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock
.pm2/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.backup
*.bak
*.tmp
*.swp
